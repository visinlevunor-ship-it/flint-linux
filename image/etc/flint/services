# Flint services, supervised by init.
#
#   name   mode      tty         command [args...]
#
# mode:  respawn = restart when it exits (with backoff if it keeps failing fast)
#        once    = run once, never restart
# tty:   '-' to inherit the console, or a /dev path to become the controlling tty
# No shell and no quoting: fields are split on whitespace.
tty1    respawn   /dev/tty1   /sbin/login
tty2    respawn   /dev/tty2   /sbin/login
