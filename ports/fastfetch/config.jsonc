// System-wide fastfetch settings for Flint Linux. Copy to ~/.config/fastfetch/config.jsonc
// to change them for one user.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/fastfetch/flint-logo.txt",
        "color": { "1": "yellow", "2": "red" },
        "padding": { "right": 2 }
    },
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
        "terminal", "cpu", "gpu", "memory", "swap", "disk", "localip", "battery", "wifi",
        "locale", "break", "colors"
    ]
}
